# web/.env.production - Next.js loads this automatically for `next build`
# and `next start`. Copy to `web/.env.production` on the server and fill in
# real values. Never commit `.env.production`.

# Public site origin (no trailing slash). Gates canonical/OG tags and
# whether /sitemap.xml, /robots.txt emit real entries - see app/lib/seo.ts.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# GA4 measurement ID. Leave unset to disable analytics entirely
# (app/lib/analytics.ts no-ops and <GoogleAnalytics> never renders).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# HTTP Basic Auth for /admin/* (checked in proxy.ts). Required in
# production - without both set, /admin/* returns 500 by design.
ADMIN_USER=
ADMIN_PASSWORD=

# Supabase (service-role - server-only, never exposed to the browser bundle)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rakuten API - used by the admin "전체 refresh 실행" button
# (web/app/admin/api/refresh-all/route.ts). Names kept as-is from existing
# code, not the more conventional RAKUTEN_APPLICATION_ID etc.
applicationId=
accessKey=

# Coupang Partners API - same admin refresh-all route
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
