# Repo-root env, used by the price-refresh CLI (src/cli/index.ts via
# `npm run cli`) - i.e. dotenv/config loading from the process's cwd. This
# is what the Oracle Cloud cron job (deploy/refresh-cron.sh) reads.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Supabase (service-role - server-only, never expose client-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rakuten API (names kept as-is from existing code: src/cli/index.ts,
# web/app/admin/api/refresh-all/route.ts both read these two exact keys)
applicationId=
accessKey=

# Coupang Partners API
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
