# Cloud Run Job image for the price-refresh CLI (src/cli/index.ts). Only
# needs the repo-root package - the web app isn't part of this image.
#
#   docker build -f deploy/gcp/Dockerfile.job -t tripprice-refresh-job .
#   docker run --rm --env-file .env tripprice-refresh-job

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# tsx/typescript are devDependencies - the job runs the CLI straight from
# TS source via tsx (same as `npm run cli` locally), no compile step, so
# do NOT set NODE_ENV=production before this install.
RUN npm ci

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY src ./src
COPY deploy/gcp/refresh-job.sh ./refresh-job.sh

ENTRYPOINT ["sh", "./refresh-job.sh"]
